    "@modelcontextprotocol/server": "2.4.0",
    "fflate": "0.8.2",
    "quickjs-emscripten-core": "0.32.0",
    "re2js": "2.10.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261125.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "miniflare": "4.20260730.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "wrangler": "4.168.0"
  }
