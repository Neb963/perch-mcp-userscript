{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "perch-mcp-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY", "class_name": "Registry" },
      { "name": "WORKSPACES", "class_name": "Workspace" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Registry", "Workspace"] },
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "vars": {
    "SQL_TELEMETRY_ENABLED": "true",
    "PROVIDER_WRITES_ENABLED": "false",
    "NATIVE_ACTIONS_ENABLED": "true",
    "ALLOWED_ORIGINS": "https://perchance.org",
  },
  "secrets": { "required": ["BOOTSTRAP_SECRET"] },
  "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true } },
  "triggers": { "crons": ["*/5 * * * *"] },
}
